<%- include("partials/header", { title: title }) %>

  <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h2 class="section-title mb-0">My Products</h2>
      <a href="/products/add" class="btn btn-success">+ Add New Product</a>
    </div>

    <% if (products.length === 0) { %>
      <div class="text-center text-muted my-5">
        <h4>You have not added any product yet</h4>
        <p>Click "Add New Product" to list your first item.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-bordered align-middle bg-white">
          <thead class="table-success">
            <tr>
              <th>Photo</th><th>Name</th><th>Category</th><th>Quantity</th><th>Price</th><th>Status</th><th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function (p) { %>
              <tr>
                <td><img src="<%= p.image ? '/uploads/' + p.image : '/images/no-image.svg' %>" class="table-img" alt=""></td>
                <td><a href="/products/<%= p._id %>"><%= p.name %></a></td>
                <td><%= p.category %></td>
                <td><%= p.quantity %></td>
                <td>Rs. <%= p.price %></td>
                <td>
                  <% if (p.status === "sold") { %>
                    <span class="badge bg-secondary">Sold</span>
                  <% } else { %>
                    <span class="badge bg-success">Available</span>
                  <% } %>
                </td>
                <td>
                  <a href="/products/<%= p._id %>/edit" class="btn btn-sm btn-primary">Edit</a>

                  <form action="/products/<%= p._id %>/sold" method="POST" class="d-inline">
                    <button class="btn btn-sm btn-warning"><%= p.status === "sold" ? "Mark Available" : "Mark as Sold" %></button>
                  </form>

                  <!-- confirm() asks "Are you sure?" before deleting -->
                  <form action="/products/<%= p._id %>/delete" method="POST" class="d-inline"
                        onsubmit="return confirm('Delete this product?');">
                    <button class="btn btn-sm btn-danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<%- include("partials/footer") %>
