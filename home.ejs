<%- include("partials/header", { title: title }) %>

  <!-- ===== Hero banner ===== -->
  <div class="hero">
    <div class="container">
      <h1 class="display-4 fw-bold">One's Unused, Another's Treasure.</h1>
      <p class="lead">List your unused items, Find someone who values them, and Give them a second life</p>
      <a href="/products/add" class="btn btn-light btn-lg me-2">Sell a Product</a>
      <a href="/browse" class="btn btn-outline-light btn-lg">Browse Products</a>
    </div>
  </div>

  <!-- ===== How it works ===== -->
  <div class="container mt-5">
    <h2 class="section-title text-center">Quick Guide</h2>
    <div class="row text-center">
      <div class="col-md-4 mb-3">
        <div class="card step-card p-4 h-100">
          <div class="step-icon">&#127991;</div>
          <h5>Let Go</h5>
          <p class="mb-0">List & sell your items</p>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="card step-card p-4 h-100">
          <div class="step-icon">&#128722;</div>
          <h5>Find Yours</h5>
          <p class="mb-0">Browse items to buy</p>
        </div>
      </div>
      <div class="col-md-4 mb-3">
        <div class="card step-card p-4 h-100">
          <div class="step-icon">&#128075;</div>
          <h5>Say Hello </h5>
          <p class="mb-0">Contact the seller</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ===== Categories ===== -->
  <div class="container mt-4 text-center">
    <h2 class="section-title">Categories</h2>
    <% categories.forEach(function (c) { %>
      <a href="/browse?category=<%= c %>" class="btn btn-outline-success category-btn m-1"><%= c %></a>
    <% }) %>
  </div>

  <!-- ===== Latest products ===== -->
  <div class="container mt-5">
    <h2 class="section-title text-center">Latest Products</h2>
    <div class="row">
      <% if (products.length === 0) { %>
        <p class="text-center text-muted">No products yet. Be the first to add one!</p>
      <% } %>
      <% products.forEach(function (p) { %>
        <%- include("partials/card", { p: p }) %>
      <% }) %>
    </div>
  </div>

<%- include("partials/footer") %>
