<%- include("partials/header", { title: title }) %>

  <div class="container mt-4">
    <a href="/browse" class="btn btn-outline-secondary mb-3">&larr; Back to Browse</a>

    <div class="row">
      <!-- Left: image -->
      <div class="col-md-6 mb-3">
        <img src="<%= product.image ? '/uploads/' + product.image : '/images/no-image.svg' %>" class="img-fluid rounded detail-img" alt="<%= product.name %>">
      </div>

      <!-- Right: details -->
      <div class="col-md-6">
        <span class="badge bg-success"><%= product.category %></span>
        <% if (product.status === "sold") { %>
          <span class="badge bg-secondary">Sold</span>
        <% } %>
        <h2 class="mt-2"><%= product.name %></h2>
        <h4 class="text-success">Rs. <%= product.price %></h4>

        <table class="table">
          <tr><th>Quantity</th><td><%= product.quantity %></td></tr>
          <tr><th>Location</th><td><%= product.location %></td></tr>
          <tr><th>Added on</th><td><%= product.createdAt.toDateString() %></td></tr>
        </table>

        <h5>Description</h5>
        <p><%= product.description || "No description given." %></p>

        <!-- Contact seller box -->
        <div class="card border-success mt-4">
          <div class="card-header bg-success text-white">Contact Seller</div>
          <div class="card-body">
            <p class="mb-1"><strong>Name:</strong> <%= product.seller ? product.seller.name : "Seller" %></p>
            <p class="mb-1"><strong>Phone:</strong> <a href="tel:<%= product.contactPhone %>"><%= product.contactPhone %></a></p>
            <% if (product.seller) { %>
              <p class="mb-0"><strong>Email:</strong> <a href="mailto:<%= product.seller.email %>"><%= product.seller.email %></a></p>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

<%- include("partials/footer") %>
