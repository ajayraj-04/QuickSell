<%- include("partials/header", { title: title }) %>

  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-5">
        <div class="card form-card p-4">
          <h2 class="mb-3 text-center">Seller Register</h2>

          <form id="registerForm" action="/register" method="POST">
            <div class="mb-3">
              <label class="form-label">Name</label>
              <input type="text" class="form-control" name="name" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Email</label>
              <input type="email" class="form-control" name="email" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Phone (10 digits)</label>
              <input type="text" class="form-control" name="phone" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Password (minimum 6 characters)</label>
              <input type="password" class="form-control" id="password" name="password" minlength="6" required>
            </div>
            <div class="mb-3">
              <label class="form-label">Confirm Password</label>
              <input type="password" class="form-control" id="confirm" required>
            </div>
            <button type="submit" class="btn btn-success w-100">Register</button>
          </form>

          <p class="mt-3 text-center mb-0">Already registered? <a href="/login">Login here</a></p>
        </div>
      </div>
    </div>
  </div>

<%- include("partials/footer") %>
