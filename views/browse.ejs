<%- include("partials/header", { title: title }) %>

  <%
    // Small helper: makes a link like /browse?category=Books&sub=Comic (keeps the search words)
    function link(cat, s) {
      var url = "/browse?category=" + encodeURIComponent(cat) + "&sub=" + encodeURIComponent(s);
      if (q) url += "&q=" + encodeURIComponent(q);
      if (location) url += "&location=" + encodeURIComponent(location);
      return url;
    }
  %>

  <div class="container mt-4">
    <h2 class="section-title">Browse Products</h2>

    <!-- ===== Search box ===== -->
    <form class="row g-2 mb-3 search-box" action="/browse" method="GET">
      <div class="col-md-5">
        <input type="text" class="form-control" name="q" placeholder="Search product name" value="<%= q %>">
      </div>
      <div class="col-md-5">
        <input type="text" class="form-control" name="location" placeholder="Location" value="<%= location %>">
      </div>
      <div class="col-md-2 d-grid">
        <button type="submit" class="btn btn-success">Search</button>
      </div>

      <!-- keep the chosen category while searching -->
      <input type="hidden" name="category" value="<%= category %>">
      <input type="hidden" name="sub" value="<%= sub %>">
    </form>

    <!-- ===== Category icons ===== -->
    <div class="cat-bar">
      <a href="/browse" class="cat-item <%= category === '' ? 'active' : '' %>">
        <span class="cat-icon">🌐</span>All
      </a>
      <% categories.forEach(function (c) { %>
        <a href="<%= link(c, '') %>" class="cat-item <%= category === c ? 'active' : '' %>">
          <span class="cat-icon"><%= categoryData[c].icon %></span><%= c %>
        </a>
      <% }) %>
    </div>

    <!-- ===== Filter (types) of the chosen category ===== -->
    <% if (category && categoryData[category]) { %>
      <div class="sub-bar">
        <b><%= category %>:</b>
        <a href="<%= link(category, '') %>" class="sub-chip <%= sub === '' ? 'active' : '' %>">All</a>
        <% categoryData[category].subs.forEach(function (s) { %>
          <a href="<%= link(category, s) %>" class="sub-chip <%= sub === s ? 'active' : '' %>"><%= s %></a>
        <% }) %>
      </div>
    <% } %>

    <p class="text-muted"><%= products.length %> product(s) found</p>

    <!-- ===== Products ===== -->
    <div class="row">
      <% if (products.length === 0) { %>
        <div class="text-center text-muted my-5">
          <h4>No products found</h4>
          <p>Try a different word or category.</p>
        </div>
      <% } %>

      <% products.forEach(function (p) { %>
        <%- include("partials/card", { p: p }) %>
      <% }) %>
    </div>
  </div>

<%- include("partials/footer") %>
